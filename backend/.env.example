# Copier ce fichier en ".env" puis ajuster les valeurs

# Base de données (SQLite en local, Postgres en production)
DATABASE_URL="file:./dev.db"

# Secret utilisé pour signer les tokens JWT - CHANGER en production
JWT_SECRET="change-moi-avec-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="7d"

# Port du serveur
PORT=4000

# Origine autorisée pour le frontend (CORS)
FRONTEND_URL="http://localhost:5173"

# Taille maximale des fichiers uploadés, en octets (ici 15 Mo)
MAX_FILE_SIZE=15728640
